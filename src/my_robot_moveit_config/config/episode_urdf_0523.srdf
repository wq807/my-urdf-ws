<?xml version="1.0" encoding="UTF-8"?>
<robot name="episode_urdf_0523">
    <group name="arm">
        <chain base_link="base_link" tip_link="L6"/>
    </group>

    <group name="gripper">
        <link name="gripper_left"/>
        <link name="gripper_right"/>
        <joint name="gripper_left_joint"/>
        <joint name="gripper_right_joint"/>
    </group>

    <group name="arm_with_gripper">
        <group name="arm" />
        <group name="gripper" />
    </group>

    <group_state name="home" group="arm">
        <joint name="J1" value="0"/>
        <joint name="J2" value="0"/>
        <joint name="J3" value="0"/>
        <joint name="J4" value="0"/>
        <joint name="J5" value="0"/>
        <joint name="J6" value="0"/>
    </group_state>

    <group_state name="home" group="arm_with_gripper">
        <joint name="J1" value="0"/>
        <joint name="J2" value="0"/>
        <joint name="J3" value="0"/>
        <joint name="J4" value="0"/>
        <joint name="J5" value="0"/>
        <joint name="J6" value="0"/>
        <joint name="gripper_left_joint" value="0.0475"/>
        <joint name="gripper_right_joint" value="0.0475"/>
    </group_state>

    <group_state name="open" group="gripper">
        <joint name="gripper_left_joint" value="0.0475"/>
        <joint name="gripper_right_joint" value="0.0475"/>
    </group_state>
    
    <group_state name="closed" group="gripper">
        <joint name="gripper_left_joint" value="0"/>
        <joint name="gripper_right_joint" value="0"/>
    </group_state>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

    <disable_collisions link1="L1" link2="L2" reason="Adjacent"/>
    <disable_collisions link1="L1" link2="base_link" reason="Adjacent"/>
    <disable_collisions link1="L2" link2="L3" reason="Adjacent"/>
    <disable_collisions link1="L2" link2="L5" reason="Never"/>
    <disable_collisions link1="L3" link2="L4" reason="Adjacent"/>
    <disable_collisions link1="L3" link2="L5" reason="Never"/>
    <disable_collisions link1="L3" link2="L6" reason="Never"/>
    <disable_collisions link1="L4" link2="L5" reason="Adjacent"/>
    <disable_collisions link1="L4" link2="L6" reason="Never"/>
    <disable_collisions link1="L5" link2="L6" reason="Adjacent"/>
    <disable_collisions link1="L6" link2="gripper_left" reason="Adjacent"/>
    <disable_collisions link1="L6" link2="gripper_right" reason="Adjacent"/>
    <disable_collisions link1="gripper_left" link2="gripper_right" reason="Never"/>
    <disable_collisions link1="L5" link2="gripper_left" reason="Never"/>
    <disable_collisions link1="L5" link2="gripper_right" reason="Never"/>

    <end_effector name="gripper" parent_link="L6" group="gripper" />
</robot>